# Vite-hashed JS/CSS assets — immutable, 1-year cache
/assets/index-*
  Cache-Control: public, max-age=31536000, immutable
/assets/MapView-*
  Cache-Control: public, max-age=31536000, immutable
/assets/SearchView-*
  Cache-Control: public, max-age=31536000, immutable

# Non-hashed assets (workers, etc.) — shorter cache, not immutable
/assets/maplibre-*
  Cache-Control: public, max-age=604800

# SVG icon
/icon.svg
  Cache-Control: public, max-age=604800

# robots.txt
/robots.txt
  Cache-Control: public, max-age=86400

# site.webmanifest
/site.webmanifest
  Cache-Control: public, max-age=604800

# HTML — never cache (SPA entry point)
/index.html
  Cache-Control: no-cache
